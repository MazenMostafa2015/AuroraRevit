<Window x:Class="AuroraRevit.AiProxy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora Revit Proxy"
        Width="760"
        Height="520"
        MinWidth="620"
        MinHeight="400"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Aurora AI Proxy"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="Local bridge for the Aurora Revit Assistant"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource SecondaryText}"
                           FontSize="12" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#E35D6A" Margin="0,0,7,0" />
                <TextBlock x:Name="StatusText" Text="Stopped" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Padding="14"
                Background="{StaticResource SurfaceBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Endpoint"
                           Foreground="{StaticResource SecondaryText}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="EndpointText"
                           Grid.Column="1"
                           Text="http://localhost:5000"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <Button x:Name="StartButton"
                        Grid.Column="2"
                        Content="Start Proxy"
                        Click="StartButton_Click"
                        Style="{StaticResource ActionButton}" />
                <Button x:Name="StopButton"
                        Grid.Column="3"
                        Content="Stop Proxy"
                        Click="StopButton_Click"
                        Style="{StaticResource ActionButton}"
                        Background="#364154" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#0B0F15"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Proxy logs"
                           Foreground="{StaticResource SecondaryText}"
                           FontSize="11"
                           Margin="14,11,14,7" />
                <ScrollViewer x:Name="LogScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14,0,14,14">
                    <TextBlock x:Name="LogTextBlock"
                               Foreground="#C9D4E3"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   x:Name="FooterText"
                   Text="Configure OpenAI:ApiKey through user-secrets or environment variables before starting the proxy."
                   Foreground="{StaticResource SecondaryText}"
                   FontSize="11"
                   Margin="2,12,2,0" />
    </Grid>
</Window>

<Window x:Class="AuroraRevit.RevitAddin.CodeViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora Code Action"
        Width="900"
        Height="620"
        MinWidth="560"
        MinHeight="380"
        Background="#10141C"
        Foreground="#F4F7FB"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryText" Color="#F4F7FB" />
        <SolidColorBrush x:Key="SecondaryText" Color="#97A3B6" />
        <SolidColorBrush x:Key="PanelBorder" Color="#293344" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C8CFF" />
        <Style x:Key="ActionButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#29356D" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E4D91" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Generated C# Code"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryText}" />
                <TextBlock Text="Review the code before transferring it to RevitPythonShell."
                           Margin="0,5,0,0"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryText}" />
            </StackPanel>
            <Border HorizontalAlignment="Right"
                    Background="#1C2433"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,5">
                <TextBlock Text="AI ACTION · CODE"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="#0B0F15"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8">
            <RichTextBox x:Name="CodeViewer"
                         IsReadOnly="True"
                         IsDocumentEnabled="False"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="#D9E2F2"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="13"
                         Padding="14"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="The button copies the code to the clipboard for manual execution."
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="11"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copy Code"
                        Click="CopyCodeButton_Click"
                        Style="{StaticResource ActionButton}" />
                <Button Content="Execute in Python Shell"
                        Click="ExecutePythonShellButton_Click"
                        Background="{StaticResource AccentBrush}"
                        Style="{StaticResource ActionButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

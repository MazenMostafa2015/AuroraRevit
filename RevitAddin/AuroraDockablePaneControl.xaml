<UserControl x:Class="AuroraRevit.RevitAddin.AuroraDockablePaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="420"
             MinHeight="50"
             Background="#10141C"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#10141C" />
        <SolidColorBrush x:Key="SurfaceBackground" Color="#171D28" />
        <SolidColorBrush x:Key="SurfaceBorder" Color="#293344" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F4F7FB" />
        <SolidColorBrush x:Key="SecondaryText" Color="#97A3B6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C8CFF" />

        <Style x:Key="RoundedButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#96A2FF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InputTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBackground}">
        <Grid x:Name="CompactBar" Height="50" VerticalAlignment="Top" Margin="8,4,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SurfaceBackground}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="7" Margin="0,0,7,0">
                <TextBox x:Name="CompactPromptTextBox" Style="{StaticResource InputTextBox}" BorderThickness="0" AcceptsReturn="False" KeyDown="CompactPromptTextBox_KeyDown" ToolTip="Ask Aurora about your Revit model..." />
            </Border>
            <Button x:Name="CompactSendButton" Grid.Column="1" Content="Send" Click="CompactSendButton_Click" Style="{StaticResource RoundedButton}" Margin="0,0,7,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,9,0">
                <Ellipse x:Name="CompactStatusDot" Width="7" Height="7" Fill="#54D69A" VerticalAlignment="Center" />
                <TextBlock x:Name="CompactStatusText" Text="Ready" Foreground="{StaticResource SecondaryText}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="ExpandChatButton" Grid.Column="3" Content="Expand Chat" Click="ExpandChatButton_Click" Style="{StaticResource RoundedButton}" Background="#29356D" />
            <Border x:Name="ToastBorder" Visibility="Collapsed" Background="#202A3A" BorderBrush="#52618F" BorderThickness="1" CornerRadius="7" Padding="10,7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,52" MaxWidth="620">
                <TextBlock x:Name="ToastText" Foreground="{StaticResource PrimaryText}" FontSize="12" TextWrapping="Wrap" MaxHeight="50" />
            </Border>
        </Grid>

        <Grid x:Name="ExpandedChatView" Visibility="Collapsed" Background="{StaticResource PanelBackground}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="18,14" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button Content="Command Bar" Click="CollapseChatButton_Click" Style="{StaticResource RoundedButton}" Background="#29356D" DockPanel.Dock="Right" />
                    <StackPanel>
                        <TextBlock Text="Aurora Assistant" Foreground="{StaticResource PrimaryText}" FontSize="15" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse Width="7" Height="7" Fill="#54D69A" /><TextBlock Text="  Local proxy ready" Foreground="{StaticResource SecondaryText}" FontSize="11" /></StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Padding="14,16,14,12"><StackPanel x:Name="ChatHistoryPanel" /></ScrollViewer>
            <Border Grid.Row="2" Background="#121823" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="0,1,0,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ComboBox x:Name="ExampleComboBox" Grid.Row="0" DisplayMemberPath="DisplayName" Foreground="{StaticResource PrimaryText}" Background="{StaticResource SurfaceBackground}" BorderBrush="{StaticResource SurfaceBorder}" Padding="8,7" FontSize="12" SelectionChanged="ExampleComboBox_SelectionChanged" Margin="0,0,0,8" />
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBackground}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="9"><TextBox x:Name="PromptTextBox" Style="{StaticResource InputTextBox}" MinHeight="44" MaxHeight="110" AcceptsReturn="True" TextWrapping="Wrap" KeyDown="PromptTextBox_KeyDown" /></Border>
                    <Grid Grid.Row="2" Margin="0,9,0,0"><TextBlock Text="Enter to send  ·  Shift+Enter for a new line" Foreground="#69758A" FontSize="10" VerticalAlignment="Center" /><Button x:Name="SendButton" Content="Send  ›" HorizontalAlignment="Right" Click="SendButton_Click" Style="{StaticResource RoundedButton}" /></Grid>
                    <Border x:Name="LoadingPanel" Grid.Row="2" Background="#1C2433" CornerRadius="8" Padding="10,7" HorizontalAlignment="Left" Visibility="Collapsed"><TextBlock Text="●  Loading..." Foreground="{StaticResource AccentBrush}" FontSize="11" /></Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

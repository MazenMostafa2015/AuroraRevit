<UserControl x:Class="AuroraRevit.RevitAddin.AuroraDockablePaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="300"
             MinHeight="420"
             Background="#10141C"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#10141C" />
        <SolidColorBrush x:Key="SurfaceBackground" Color="#171D28" />
        <SolidColorBrush x:Key="SurfaceBorder" Color="#293344" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F4F7FB" />
        <SolidColorBrush x:Key="SecondaryText" Color="#97A3B6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C8CFF" />
        <SolidColorBrush x:Key="UserBubble" Color="#303A66" />
        <SolidColorBrush x:Key="AssistantBubble" Color="#1B2330" />

        <Style x:Key="RoundedButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#96A2FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18,16,18,14"
                BorderBrush="{StaticResource SurfaceBorder}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="10" Background="#29356D">
                    <TextBlock Text="✦"
                               Foreground="#DCE1FF"
                               FontSize="19"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,0,0">
                    <TextBlock Text="Aurora Assistant"
                               Foreground="{StaticResource PrimaryText}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse Width="7" Height="7" Fill="#54D69A" VerticalAlignment="Center" />
                        <TextBlock Text="  Local proxy ready"
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="REVIT"
                           Foreground="#66738A"
                           FontSize="10"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      x:Name="ChatScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="14,16,14,12">
            <StackPanel x:Name="ChatHistoryPanel" />
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#121823"
                BorderBrush="{StaticResource SurfaceBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,12,12,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,9">
                    <TextBlock Text="Example Library"
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="10"
                               Margin="2,0,0,4" />
                    <ComboBox x:Name="ExampleComboBox"
                              DisplayMemberPath="DisplayName"
                              Foreground="{StaticResource PrimaryText}"
                              Background="{StaticResource SurfaceBackground}"
                              BorderBrush="{StaticResource SurfaceBorder}"
                              BorderThickness="1"
                              Padding="8,7"
                              FontSize="12"
                              SelectionChanged="ExampleComboBox_SelectionChanged"
                              ToolTip="Choose a discipline example to populate the prompt, including MEP: Count All HVAC Ducts." />
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource SurfaceBackground}"
                        BorderBrush="{StaticResource SurfaceBorder}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <TextBox x:Name="PromptTextBox"
                             Style="{StaticResource InputTextBox}"
                             MinHeight="44"
                             MaxHeight="110"
                             KeyDown="PromptTextBox_KeyDown"
                             ToolTip="Ask Aurora about your Revit model..." />
                </Border>
                <Grid Grid.Row="2" Margin="0,9,0,0">
                    <TextBlock Text="Try MEP: Count all HVAC ducts  ·  Enter to send"
                               Foreground="#69758A"
                               FontSize="10"
                               VerticalAlignment="Center" />
                    <Button x:Name="SendButton"
                            Content="Send  ›"
                            HorizontalAlignment="Right"
                            Click="SendButton_Click"
                            Style="{StaticResource RoundedButton}" />
                </Grid>
                <Border x:Name="LoadingPanel"
                        Grid.Row="2"
                        Background="#1C2433"
                        CornerRadius="8"
                        Padding="10,7"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12"
                                   Margin="0,0,7,0">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="LoadingRotation" CenterX="6" CenterY="6" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="LoadingRotation"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                        <TextBlock Text="Loading..."
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

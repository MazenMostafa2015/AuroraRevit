<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF1E1E1E">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Name="StatusDot" Text="●" Foreground="#FF66CC66" FontSize="16" Width="24" />
      <TextBlock Name="StatusText" Text="AI/Proxy ready" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button Name="ExpandButton" Content="Expand Chat" Width="105" Height="26" Background="#FF0078D4" Foreground="White" Margin="0,0,6,0" />
      <Button Name="LastLogButton" Content="Show Last Log Entry" Width="145" Height="26" Background="#FF0078D4" Foreground="White" />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="80" />
      </Grid.ColumnDefinitions>
      <TextBox Name="CommandInput" Grid.Column="0" Height="30" Background="#FF2D2D2D" Foreground="White" BorderBrush="#FF0078D4" />
      <Button Name="SendButton" Grid.Column="1" Content="Send" Width="80" Height="30" Background="#FF0078D4" Foreground="White" Margin="8,0,0,0" />
    </Grid>
  </Grid>
</Page>
